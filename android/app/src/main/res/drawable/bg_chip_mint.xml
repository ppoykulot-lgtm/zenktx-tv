<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen player server: a dark chip lifted by a mint edge, so four
     stations in a row read as one pick instead of four white blocks. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#16213A" />
            <stroke
                android:width="2dp"
                android:color="@color/mint" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#11302C" />
            <stroke
                android:width="1dp"
                android:color="@color/mint" />
        </shape>
    </item>
</selector>
