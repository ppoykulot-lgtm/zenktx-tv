<?xml version="1.0" encoding="utf-8"?>
<!-- The TV player. The picture owns the screen; the two corner buttons (star and
     ✕) and the CH ▲ / CH ▼ pair are gone, because on a remote the channel is
     changed with ▲ / ▼ on the picture itself and the way out is BACK. What is
     left is one bar that only appears when asked for, plus a legend that says
     which key does what. The phone keeps its own copy of this file. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Channel banner, top-left: what is on, and where it sits in the list.
         Every channel hop raises it for a few seconds. -->
    <LinearLayout
        android:id="@+id/channelChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="26dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_player_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channelMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:textColor="@color/mint"
                android:textSize="8sp"
                android:textStyle="bold" />

            <!-- What the guide says is on now, under the channel name. -->
            <TextView
                android:id="@+id/epgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxWidth="320dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#D8E6FF"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/mint"
        android:visibility="gone" />

    <!-- One bar: a single row of controls and one row of key hints. OK on the
         picture raises it; ▲ / ▼ on the picture changes channel without it. -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_player_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- One row, in the order a remote walks it: play first, then the
             running time, the timeline and where the stream ends, then the
             sound and the quality. The old bar stacked a time row above a
             button row and the two collided over the picture. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_play"
                android:contentDescription="@string/watch_now"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <TextView
                android:id="@+id/pTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="monospace"
                android:text="--:--"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/mint"
                android:thumbTint="@color/mint" />

            <TextView
                android:id="@+id/pTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="LIVE"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_player_chip"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="LIVE"
                android:textColor="@color/mint"
                android:textSize="8sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="18dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/player_volume"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume" />

            <SeekBar
                android:id="@+id/volBar"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="@color/mint"
                android:thumbTint="@color/mint" />

            <TextView
                android:id="@+id/btnQuality"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_player_chip"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="70dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/player_quality_auto"
                android:textColor="@color/mint"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGuide"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_player_chip"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="70dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/player_guide"
                android:textColor="@color/mint"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Key legend, so the remote never needs a manual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="@string/key_arrows_updown"
                android:textColor="@color/text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/player_hint_zap_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="@string/key_ok"
                android:textColor="@color/text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/player_hint_ok_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="@string/key_back"
                android:textColor="@color/text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/player_hint_exit_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Failure panel: always explains what happened and what to do next -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/player_error_label"
            android:textColor="@color/mint"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/errorCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tag"
            android:letterSpacing="0.06"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#8FE7D6"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/player_retry"
                android:textColor="@color/btn_primary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/player_next"
                android:textColor="@color/text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_back"
                android:textColor="@color/text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
