<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- The monogram sits under the logo: channels without one, and logos
             whose host is gone, show their initials instead of a play glyph. -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp">

            <TextView
                android:id="@+id/tileMonogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="#F2F6FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/tileLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#C7D2E6"
            android:textSize="8sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="@color/mint"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
