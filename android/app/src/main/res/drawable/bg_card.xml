<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@drawable/bg_tile_glow" android:state_focused="true" />

    <item android:state_pressed="true">
        <layer-list>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="#16223A" />
                    <stroke
                        android:width="1dp"
                        android:color="#2A3A57" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:drawable="@drawable/bg_tile" />
</selector>
