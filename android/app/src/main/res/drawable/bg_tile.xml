<?xml version="1.0" encoding="utf-8"?>
<!-- The resting EPG cell. The surface is inset 6dp, the same ring the focused
     version fills with its halo, so the card never changes size under the D-pad. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</layer-list>
