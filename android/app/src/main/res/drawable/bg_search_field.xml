<?xml version="1.0" encoding="utf-8"?>
<!-- The TV search bar, sitting under the categories. Wide enough to read as a
     field rather than a button, and lit with the same mint ring as a focused
     tile so the D-pad highlight is never in doubt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#14293D" />
            <stroke
                android:width="2dp"
                android:color="@color/mint" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</selector>
