<?xml version="1.0" encoding="utf-8"?>
<!-- The resting EPG cell. The surface is inset 6dp, the same ring the focused
     version fills with its halo, so the card never changes size under the D-pad.
     The edge is 2dp and brighter than the old hairline: at television distance a
     1dp line in #364566 read as no border at all. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="2dp"
                android:color="#3E5478" />
        </shape>
    </item>
</layer-list>
