<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile tile: three across, an 84dp logo inside a 118dp card — the tight
     thumbnail grid phone users expect, with the logo big enough to read at a
     glance instead of shrinking the artwork to a dot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:paddingStart="7dp"
    android:paddingTop="7dp"
    android:paddingEnd="7dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tileLogo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:textColor="#C7D2E6"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="@color/mint"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
