<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal, remote-first controls. Media3 swaps this in for the default
  touch-oriented controller. Every control is focusable so a D-pad works.

  The bar floats as a rounded translucent capsule over the picture (the "Glass"
  look of the desktop build) instead of a full-width strip, and the play/pause
  key is a small round button rather than a slab next to thin glyphs.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_player_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/PlayerButtonPrimary"
            android:contentDescription="@string/watch_now" />

        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_player_chip"
            android:letterSpacing="0.18"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="LIVE"
            android:textColor="@color/mint"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- The favourite star lives in activity_player.xml, outside this
             controller: this bar is inflated and hidden by Media3, which made
             a button here unreliable to reach. -->
        <TextView
            android:id="@+id/btnPrev"
            style="@style/PlayerChipButton"
            android:contentDescription="Previous channel"
            android:text="&#9650;" />

        <TextView
            android:id="@+id/btnNextChannel"
            style="@style/PlayerChipButton"
            android:layout_marginStart="10dp"
            android:contentDescription="Next channel"
            android:text="&#9660;" />
    </LinearLayout>
</merge>
