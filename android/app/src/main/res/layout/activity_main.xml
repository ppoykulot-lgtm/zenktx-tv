<?xml version="1.0" encoding="utf-8"?>
<!-- Design B — GUIDE for a TV: brand header, wrapped categories, a search bar
     under them, the EPG grid, and a D-pad legend where the detail strip used
     to sit. Every band is clipped to its own bounds, so a focused tile can lift
     and scale without sliding under the categories above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="20dp"
        android:paddingEnd="40dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_mark" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/brand_name"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.34"
                    android:text="@string/brand_sub"
                    android:textColor="@color/mint"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/channelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:letterSpacing="0.1"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="--:--"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/menu"
                android:textColor="@color/pill_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Categories: one row, sliding sideways, so the band never wraps into
             a second row that pushes the guide down. The strip on the right
             fades the chip that runs past the edge instead of cutting it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:scrollbars="none" />

            <!-- A fixed height, not match_parent: a fill-height child would
                 stretch this wrap_content frame to the whole screen and push
                 the search bar and the grid below it. -->
            <View
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_chips_fade"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Search sits under the categories and says what it is -->
        <TextView
            android:id="@+id/searchButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:letterSpacing="0.02"
            android:minWidth="460dp"
            android:paddingStart="18dp"
            android:paddingEnd="22dp"
            android:text="@string/search_channel"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- EPG grid. The top padding is the room a focused tile needs to lift
             into: clipToPadding keeps it inside the grid instead of letting it
             draw over the categories. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:paddingStart="4dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:scrollbars="none" />

        <!-- D-pad legend, where the detail strip used to be -->
        <LinearLayout
            android:id="@+id/guideRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/key_arrows"
                android:textColor="@color/text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/key_move"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="22dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/key_ok"
                android:textColor="@color/text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/key_watch"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="22dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/key_hold"
                android:textColor="@color/text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/key_favourite"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_keycap"
                android:gravity="center"
                android:minWidth="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/key_menu"
                android:textColor="@color/text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/key_settings"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sits on top until the current catalogue has been pulled. -->
    <include
        android:id="@+id/welcomePanel"
        layout="@layout/view_welcome" />
</FrameLayout>
