<?xml version="1.0" encoding="utf-8"?>
<!-- The phone tile. The TV build insets its surface to make room for a focus
     halo; a phone card is tapped, never focused from a sofa, so it keeps the
     flush edge and the thin outline it had. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#14293D" />
            <stroke
                android:width="2dp"
                android:color="@color/mint" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#16223A" />
            <stroke
                android:width="1dp"
                android:color="#2A3A57" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</selector>
