<?xml version="1.0" encoding="utf-8"?>
<!-- The highlighted EPG cell. The halo is a stack of 1dp rings outside the card,
     each fainter than the one inside it, so the mint light fades away from the
     edge. A radial gradient cannot do this: its centre is the middle of the card,
     where the card itself covers it, leaving only the faint rim showing. The card
     is inset 6dp and the rings fill that ring; 1dp steps keep the fade smooth at
     the pixel sizes a TV renders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0A35E7C0" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="#1235E7C0" />
        </shape>
    </item>

    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1A35E7C0" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#2235E7C0" />
        </shape>
    </item>

    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#2A35E7C0" />
        </shape>
    </item>

    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#3335E7C0" />
        </shape>
    </item>

    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#14293D" />
            <stroke
                android:width="2dp"
                android:color="@color/mint" />
        </shape>
    </item>
</layer-list>
