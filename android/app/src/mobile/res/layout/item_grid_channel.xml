<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile tile: three across, a 66dp logo inside a 105dp card — the tight
     thumbnail grid phone users expect, without shrinking the artwork to a dot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="105dp"
    android:layout_margin="4dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:paddingStart="8dp"
    android:paddingTop="9dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tileLogo"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:contentDescription="@string/app_name"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="#C7D2E6"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="@color/mint"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
