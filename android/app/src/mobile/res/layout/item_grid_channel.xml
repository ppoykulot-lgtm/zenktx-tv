<?xml version="1.0" encoding="utf-8"?>
<!-- Mobile tile. Sized like the Windows one: an 84px logo inside a 152px card,
     instead of a 54dp logo inside 112dp that made every logo look shrunken. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="152dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tileLogo"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@string/app_name"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="#C7D2E6"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tileStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★"
        android:textColor="@color/mint"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
