<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal, remote-first controls. Media3 swaps this in for the default
  touch-oriented controller. Every control is focusable so a D-pad works.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_gradient"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/PlayerButton"
                android:contentDescription="@string/watch_now" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_player_chip"
                android:letterSpacing="0.18"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="LIVE"
                android:textColor="@color/mint"
                android:textSize="8sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_player_button"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="86dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="CH ▲"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextChannel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_player_button"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="86dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="CH ▼"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</merge>
