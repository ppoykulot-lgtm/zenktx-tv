{
  "name": "zenktx-tv",
  "productName": "ZENKTX TV Stream",
  "version": "1.5.2",
  "description": "Remote-first live TV player for Android TV, Android and Windows",
  "main": "main.js",
  "author": {
    "name": "ZENKTX",
    "email": "hello@zenktx.tv"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "integrity": "node scripts/make-integrity.js",
    "dist": "node scripts/vendor.js && node scripts/make-integrity.js && electron-builder --win --x64",
    "dist:portable": "node scripts/vendor.js && node scripts/make-integrity.js && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "ph.zenktx.tv",
    "productName": "ZENKTX TV Stream",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "integrity.json",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ZENKTX-Setup-${version}.${ext}",
      "shortcutName": "ZENKTX TV Stream"
    },
    "portable": {
      "artifactName": "ZENKTX-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "shaka-player": "^4.16.55"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
