<?xml version="1.0" encoding="utf-8"?>
<!-- The selected tab. A light fill at this size glares on a phone in the dark,
     so the active half is a dark surface lifted by a mint edge instead. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#16213A" />
            <stroke
                android:width="2dp"
                android:color="@color/mint" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#121C30" />
            <stroke
                android:width="1dp"
                android:color="@color/mint" />
        </shape>
    </item>
</selector>
