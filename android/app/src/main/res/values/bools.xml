<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The TV guide has the height to show every category at once. -->
    <bool name="chips_wrap">true</bool>

    <!-- One click opens a channel on every build; nothing waits for a second tap. -->
    <bool name="full_view">false</bool>

    <!-- A TV has no status or navigation bar to hide. -->
    <bool name="hide_system_bars">false</bool>
</resources>
